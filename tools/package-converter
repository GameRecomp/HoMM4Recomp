#!/usr/bin/env bash
# SPDX-License-Identifier: MIT
# Pack the converter for one system to run on, as TropicoRecomp does: the
# recomp program, every shell template in TEMPLATE_DIR (so it builds for all
# of them, as the page does) and a README, in a folder named after the
# archive.
#
#   tools/package-converter RECOMP TEMPLATE_DIR OUT.zip|OUT.tar.gz
#
# RECOMP is the built program (recomp, or recomp.exe for Windows; the name
# in the archive follows it). A .zip suits Windows, a .tar.gz keeps the
# program executable on Linux and macOS.
set -euo pipefail
recomp=$(realpath "${1:?recomp program}")
templates=$(realpath "${2:?template directory}")
out=${3:?output archive}
mkdir -p "$(dirname "$out")"
out=$(realpath "$(dirname "$out")")/$(basename "$out")
cd "$(dirname "$0")/.."
case "$out" in
    *.zip) name=$(basename "$out" .zip) ;;
    *.tar.gz) name=$(basename "$out" .tar.gz) ;;
    *) echo "package-converter: $out: neither .zip nor .tar.gz" >&2; exit 1 ;;
esac
shopt -s nullglob
zips=("$templates"/*-*.zip)
if [ ${#zips[@]} -eq 0 ]; then
    echo "package-converter: no templates in $templates" >&2
    exit 1
fi
prog=recomp run=./recomp
case "$recomp" in *.exe) prog=recomp.exe run=recomp.exe ;; esac

stage=$(mktemp -d)
trap 'rm -rf "$stage"' EXIT
dir=$stage/$name
mkdir -p "$dir/templates"
cp "$recomp" "$dir/$prog"
chmod 755 "$dir/$prog"
cp "${zips[@]}" "$dir/templates/"

# What it builds for, from the templates' names (Heroes4-linux.zip).
systems=$(for z in "${zips[@]}"; do b=${z##*/}; b=${b%.zip}; echo "${b##*-}"; done | sort -u | tr '\n' ' ')
games=""
for g in heroes4; do
    . tools/game-info "$g"
    have=("$templates/$GAME_STEM-"*.zip)
    if [ ${#have[@]} -gt 0 ]; then
        games+="    $GAME_INSTALLER"$'\n'"        $GAME_NAME"$'\n'
    fi
done
sed 's/$/\r/' > "$dir/README.txt" <<EOF
HoMM4Recomp converter $(tools/version)

Turns your own copy of Heroes of Might and Magic IV into a build of it
for a system, as the converter page does in a browser, here without a
browser and without a network connection. What it takes (the GOG
installer; keep its -1.bin file beside it):

$games
It builds for: ${systems% }

    $run convert --system linux "setup_heroes_of_might_and_magic_4_complete_3.0_(german)_(25023).exe"

writes Heroes4-linux.zip (an .apk for android) in the current folder; -o names another
file. The build contains your copy of the game: keep it for yourself and
do not share it.

    $run help

lists the commands. On macOS the program is not signed: allow it once
with  xattr -d com.apple.quarantine recomp

https://github.com/GameRecomp/HoMM4Recomp
EOF

rm -f "$out"
case "$out" in
    *.zip) (cd "$stage" && zip -qrX "$out" "$name") ;;
    *.tar.gz) tar -C "$stage" -czf "$out" "$name" ;;
esac
echo "$out"
